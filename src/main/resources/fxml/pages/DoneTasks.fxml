<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<ScrollPane styleClass="clean-scroll" stylesheets="@../../styles/pages/TodayTasks.css" fitToWidth="true" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="com.smarttask.manager.presentation.controllers.pages.DoneTaskController">
    <VBox HBox.hgrow="ALWAYS" styleClass="main-content">
        <padding>
            <Insets top="35" right="100" bottom="35" left="100"/>
        </padding>
        <HBox alignment="CENTER_LEFT" spacing="15">
            <Label text="Achevé" styleClass="page-title"/>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>
        <VBox styleClass="task-list-container">
            <VBox styleClass="todayTask-container">
                <HBox alignment="CENTER_LEFT" spacing="15" styleClass="todayTask-banner">
                    <Label text="Completed Tasks" styleClass="todayTask-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                </HBox>
                <Region prefHeight="1" maxHeight="1" minHeight="1" styleClass="divider"/>
                <VBox styleClass="todayTask-layout">
                    <fx:include fx:id="doneTaskList" source="../components/TaskList.fxml" />
                </VBox>
            </VBox>
        </VBox>
    </VBox>
</ScrollPane>
