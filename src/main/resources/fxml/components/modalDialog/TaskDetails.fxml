<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.shape.SVGPath?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.smarttask.manager.presentation.controllers.components.modalDialog.TaskDetailsController"
      spacing="15" alignment="CENTER" fillWidth="false" stylesheets="@../../../styles/components/modalDialog/TaskDetails.css" style="-fx-background-color: #00000082;">

    <VBox styleClass="taskDetails-container" prefWidth="700.0" spacing="15">
        <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
        <HBox alignment="CENTER_LEFT">
            <HBox spacing="12" alignment="CENTER_LEFT" styleClass="container-header">
                <SVGPath
                    content="M9 3.75H6.912a2.25 2.25 0 0 0-2.15 1.588L2.35 13.177a2.25 2.25 0 0 0-.1.661V18a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18v-4.162c0-.224-.034-.447-.1-.661L19.24 5.338a2.25 2.25 0 0 0-2.15-1.588H15M2.25 13.5h3.86a2.25 2.25 0 0 1 2.012 1.244l.256.512a2.25 2.25 0 0 0 2.013 1.244h3.218a2.25 2.25 0 0 0 2.013-1.244l.256-.512a2.25 2.25 0 0 1 2.013-1.244h3.859M12 3v8.25m0 0-3-3m3 3 3-3"
                    fill="transparent"
                    stroke="#212529"
                    strokeWidth="1.75"
                    scaleX="0.9" scaleY="0.9"
                    strokeLineCap="ROUND"
                    strokeLineJoin="ROUND"/>
                <Label text="Task Details" styleClass="container-header-label"/>
            </HBox>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox spacing="12" alignment="CENTER_LEFT" styleClass="container-header-actions">
                <Button fx:id="btnCancel" onAction="#handleCancel" styleClass="icon-button-transparent" prefWidth="30" prefHeight="30" maxWidth="30" maxHeight="30" minWidth="30" minHeight="30">
                    <graphic>
                        <SVGPath
                            content="M6 18 L18 6 M6 6 L18 18"
                            fill="transparent"
                            stroke="#939595"
                            strokeWidth="1.75"
                            scaleX="0.9" scaleY="0.9"
                            strokeLineCap="ROUND"
                            strokeLineJoin="ROUND"/>
                    </graphic>
                </Button>
            </HBox>
        </HBox>
        <Region prefHeight="1" maxHeight="1" minHeight="1" styleClass="divider"/>
        <VBox alignment="CENTER_LEFT" styleClass="task-details-banner" spacing="25">
            <VBox alignment="CENTER_LEFT" spacing="20">
                <VBox styleClass="task-details" spacing="10">
                    <Label text="Task" styleClass="task-detail-label"/>
                    <Label text="Emmener les enfants to GitHub" styleClass="task-title-detail"/>
                </VBox>
                <VBox styleClass="task-details" spacing="10">
                    <Label text="Description" styleClass="task-detail-label"/>
                    <Label text="No Description" styleClass="task-desc-detail"/>
                </VBox>
            </VBox>
            <HBox alignment="CENTER_LEFT" spacing="15">
                <VBox styleClass="task-details" spacing="10" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                    <Label text="Date" styleClass="task-detail-label"/>
                    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="task-detail-item">
                        <SVGPath
                                content="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5m-9-6h.008v.008H12v-.008ZM12 15h.008v.008H12V15Zm0 2.25h.008v.008H12v-.008ZM9.75 15h.008v.008H9.75V15Zm0 2.25h.008v.008H9.75v-.008ZM7.5 15h.008v.008H7.5V15Zm0 2.25h.008v.008H7.5v-.008Zm6.75-4.5h.008v.008h-.008v-.008Zm0 2.25h.008v.008h-.008V15Zm0 2.25h.008v.008h-.008v-.008Zm2.25-4.5h.008v.008H16.5v-.008Zm0 2.25h.008v.008H16.5V15Z"
                                fill="transparent"
                                stroke="#ff9a1f"
                                strokeWidth="1.5"
                                scaleX="0.7" scaleY="0.7"
                                strokeLineCap="ROUND"
                                strokeLineJoin="ROUND"/>
                        <Label text="Fev 5, 7 AM" styleClass="task-detail-item-date"/>
                    </HBox>
                </VBox>
                <VBox styleClass="task-details" spacing="10" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                    <Label text="Priorité" styleClass="task-detail-label"/>
                    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="task-detail-item">
                        <SVGPath
                                content="M3 3v1.5 M3 21v-6 m0 0 2.77-.693a9 9 0 0 1 6.208.682l.108.054a9 9 0 0 0 6.086.71l3.114-.732a48.524 48.524 0 0 1-.005-10.499l-3.11.732a9 9 0 0 1-6.085-.711l-.108-.054a9 9 0 0 0-6.208-.682L3 4.5 M3 15V4.5"
                                fill="transparent"
                                stroke="#db4c3f"
                                strokeWidth="1.5"
                                scaleX="0.7" scaleY="0.7"
                                strokeLineCap="ROUND"
                                strokeLineJoin="ROUND"/>
                        <Label text="High" styleClass="task-detail-item-priorite"/>
                    </HBox>
                </VBox>
                <VBox styleClass="task-details" spacing="10" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                    <Label text="Status" styleClass="task-detail-label"/>
                    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="task-detail-item">
                        <SVGPath
                                content="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z M7 7l0.01 0"
                                fill="transparent"
                                stroke="#a842f5"
                                strokeWidth="1.5"
                                scaleX="0.65" scaleY="0.65"
                                strokeLineCap="ROUND"
                                strokeLineJoin="ROUND"/>
                        <Label text="Done" styleClass="task-detail-item-status"/>
                    </HBox>
                </VBox>
            </HBox>
            <fx:include source="../AddSubTask.fxml" />
        </VBox>
        <Region prefHeight="1" maxHeight="1" minHeight="1" styleClass="divider"/>
        <fx:include source="CommentBox.fxml" />
    </VBox>
</VBox>