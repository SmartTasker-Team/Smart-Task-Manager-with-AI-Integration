<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<VBox styleClass="section-container" stylesheets="@../../styles/components/SectionTaskList.css" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="com.smarttask.manager.presentation.controllers.SectionTaskListController">
    <HBox alignment="CENTER_LEFT" spacing="15" styleClass="section-banner">
        <Button onAction="#onToggleSection" styleClass="icon-button-transparent" prefWidth="30" prefHeight="30" maxWidth="30" maxHeight="30" minWidth="30" minHeight="30">
            <graphic>
                <SVGPath
                        fx:id="toggleIcon"
                        content="m19.5 8.25-7.5 7.5-7.5-7.5"
                        fill="transparent"
                        stroke="#495057"
                        strokeWidth="1.75"
                        scaleX="0.65" scaleY="0.65"
                        strokeLineCap="ROUND"
                        strokeLineJoin="ROUND"/>
            </graphic>
        </Button>
        <Label text="Coding" styleClass="section-task-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button styleClass="icon-button-transparent" prefWidth="30" prefHeight="30" maxWidth="30" maxHeight="30" minWidth="30" minHeight="30">
            <graphic>
                <SVGPath
                        content="M6.75 12a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0ZM12.75 12a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0ZM18.75 12a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z"
                        fill="transparent"
                        stroke="#495057"
                        strokeWidth="1.75"
                        scaleX="0.9" scaleY="0.9"
                        strokeLineCap="ROUND"
                        strokeLineJoin="ROUND"/>
            </graphic>
        </Button>
    </HBox>
    <Region prefHeight="1" maxHeight="1" minHeight="1" styleClass="divider"/>
    <VBox styleClass="section-task-layout" fx:id="sectionContent">
        <fx:include source="TaskList.fxml" />
        <fx:include source="AddTask.fxml" />
    </VBox>
</VBox>
